# Copy this file to .env and fill in your own values.
#
# .env is git-ignored and must NEVER be committed. To ship secrets with an
# open-source repo, encrypt them instead:
#   node scripts/secrets.mjs encrypt      # writes .env.enc (safe to commit)
# then at runtime provide the master key out-of-band:
#   SATQUERY_MASTER_KEY=... npm start
# The server auto-loads .env.enc when SATQUERY_MASTER_KEY is set; a local
# plaintext .env still takes precedence for day-to-day development.

# --- Copernicus Data Space Sentinel Hub OAuth client (server only) ---
SENTINEL_PROVIDER=cdse
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# --- OpenRouter multimodal model (optional; free models exist, e.g. google/gemini-2.0-flash-exp:free) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# --- Google Gemini API key (optional) ---
GEMINI_API_KEY=

# --- Separate remote-sensing model / orchestrator endpoint (optional) ---
MODEL_API_URL=
MODEL_API_KEY=

# --- Master key for .env.enc (optional; set in your shell/CI, do NOT put it here) ---
# SATQUERY_MASTER_KEY=
